+void GXSetFoliageWindAurora(GXBool enable, const f32* params) {
+  GX_WRITE_AURORA(GX_AURORA_FOLIAGE_WIND);
+  GX_WRITE_U32(enable ? 1u : 0u);
+  for (int i = 0; i < 20; ++i) {
+    GX_WRITE_F32(params != nullptr ? params[i] : 0.0f);
+  }
